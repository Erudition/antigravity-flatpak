#!/bin/sh
# Centralized Host-Switch Helper for Antigravity Tool Wrappers
# Resolves its own name (via symlink basename) to the host-side command.
# Installed as symlinks: git -> antigravity-host-exec, pnpm -> antigravity-host-exec, etc.

if [ -d "/gnu/store" ]; then
    HOST_UID=$(stat -c '%u' "$HOME")
    HOST_USER=$(id -un)
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$HOST_UID/bus"
    export PATH="/home/$HOST_USER/.guix-home/profile/bin:/home/$HOST_USER/.config/guix/current/bin:/home/$HOST_USER/.guix-profile/bin:/run/current-system/profile/bin:$PATH"
fi

CMD=$(basename "$0")

# Build a properly quoted argument string for the host-side bash.
ARGS=""
for arg in "$@"; do
    ARGS="$ARGS $(printf '%q' "$arg")"
done

# Hardcode corepack for pnpm/pnpx so we don't need interactive aliases to resolve them.
if [ "$CMD" = "pnpm" ] || [ "$CMD" = "pnpx" ]; then
    CMD="corepack $CMD"
fi

# Use env to force non-interactive paged output.
# Use -c (non-interactive) to prevent sourcing ~/.bashrc for every single tool call.
exec /app/bin/host-spawn env PAGER=cat MANPAGER=cat bash -c "$CMD$ARGS"
