#!/usr/bin/env bash
# Antigravity Host-Integrated Bash Wrapper (Flatpak)
# Distro-agnostic solution for reliable process termination and host tool access.

# 1. Distro-Specific Path Injection (Guix-Friendly)
# Handles systems where host binaries are in non-standard paths (e.g., /gnu/store).
if [ -d "/gnu/store" ]; then
    # Note: Using $USER instead of hardcoded 'adroit' for general portability.
    HOST_USER=$(stat -c '%U' "$HOME")
    export PATH="/home/$HOST_USER/.guix-home/profile/bin:/home/$HOST_USER/.config/guix/current/bin:/home/$HOST_USER/.guix-profile/bin:/run/current-system/profile/bin:$PATH"
fi

# 2. Command Execution via PID-Bridge (Distro-Agnostic)
# Ensures termination signals reach the host process by bridging the 'Portal Wall'.
if [[ "$1" == "-c" ]]; then
    CMD="$2"
    shift 2

    # PID Management and shared storage
    PID_DIR="$HOME/.cache/antigravity/pids"
    mkdir -p "$PID_DIR"
    TOKEN=$(mktemp -u XXXXXXXX)
    PID_FILE="$PID_DIR/$TOKEN"

    # Launch host process and capture its PID via a temporary token file.
    /usr/bin/flatpak-spawn --host --env="TERM=xterm-256color" \
        bash -l -c "echo \$\$ > '$PID_FILE'; exec bash -c \"\$1\"" -- "$CMD" &
    SPAWN_PID=$!

    # Trap termination signals to explicitly clean up host-side background processes.
    trap '
        if [ -s "$PID_FILE" ]; then
            HOST_PID=$(cat "$PID_FILE")
            # Signal bridging across the portal
            /usr/bin/flatpak-spawn --host kill $HOST_PID 2>/dev/null
        fi
        kill $SPAWN_PID 2>/dev/null
        rm -f "$PID_FILE"
        exit
    ' SIGTERM SIGINT EXIT

    wait $SPAWN_PID
    exit $?
else
    # 3. Interactive/Direct Mode
    exec /usr/bin/flatpak-spawn --host --env="TERM=xterm-256color" bash -l "$@"
fi
