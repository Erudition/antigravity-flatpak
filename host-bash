#!/usr/bin/env bash
# Antigravity Host-Integrated Bash Wrapper (Host-Spawn Edition)
# Supporting robust TTY management and fixing "dumb" terminal errors.

if [ -d "/gnu/store" ]; then
    HOST_USER=$(stat -c '%U' "$HOME")
    export PATH="/home/$HOST_USER/.guix-home/profile/bin:/home/$HOST_USER/.config/guix/current/bin:/home/$HOST_USER/.guix-profile/bin:/run/current-system/profile/bin:$PATH"
fi

# We use host-spawn which handles PTY allocation and signals across the portal.
if [[ "$1" == "-c" ]]; then
    CMD="$2"
    shift 2
    # AGENT MODE: Disable Starship to avoid ANSI/PTY pollution in command output.
    export STARSHIP_DISABLE=true
    export TERM=dumb  # Revert to dumb for non-interactive tasks to be safe for parsers
    exec /app/bin/host-spawn bash -l -c "$CMD"
else
    # INTERACTIVE MODE: Keep Starship and high-quality TTY support for the user.
    export TERM=xterm-256color
    exec /app/bin/host-spawn bash -l "$@"
fi
