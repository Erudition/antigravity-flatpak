#!/usr/bin/env bash
# Antigravity Host-Integrated Bash Wrapper (Host-Spawn Edition)
# Using host-spawn for robust signal propagation and PTY management.

if [ -d "/gnu/store" ]; then
    HOST_USER=$(stat -c '%U' "$HOME")
    export PATH="/home/$HOST_USER/.guix-home/profile/bin:/home/$HOST_USER/.config/guix/current/bin:/home/$HOST_USER/.guix-profile/bin:/run/current-system/profile/bin:$PATH"
fi

# We use host-spawn which handles PTY allocation and signals better than flatpak-spawn.
# Note: we use 'exec' to hand over control to host-spawn immediately.
if [[ "$1" == "-c" ]]; then
    CMD="$2"
    shift 2
    exec /app/bin/host-spawn bash -l -c "$CMD"
else
    # Interactive mode
    exec /app/bin/host-spawn bash -l "$@"
fi
