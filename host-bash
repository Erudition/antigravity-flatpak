#!/usr/bin/env bash
# Antigravity Host-Integrated Bash Wrapper (Host-Spawn Edition)
# Provides robust PTY and signal management across the Flatpak portal.

if [ -d "/gnu/store" ]; then
    HOST_USER=$(id -un)
    export PATH="/home/$HOST_USER/.guix-home/profile/bin:/home/$HOST_USER/.config/guix/current/bin:/home/$HOST_USER/.guix-profile/bin:/run/current-system/profile/bin:$PATH"
fi

if [[ "$1" == "-c" ]]; then
    CMD="$2"
    shift 2

    # AGENT MODE: Non-interactive, machine-readable output.
    # Set env vars via host-spawn env so they exist BEFORE bash sources .bashrc.
    # PAGER/MANPAGER=cat prevents git/man from launching interactive pagers.
    exec /app/bin/host-spawn env PAGER=cat MANPAGER=cat bash -c "$CMD"
else
    # INTERACTIVE MODE: Full TTY for the user (non-login shell to avoid .bash_profile noise).
    export TERM=xterm-256color
    # Unset global pager overrides so the user's shell is fully interactive.
    exec /app/bin/host-spawn env PAGER='' MANPAGER='' bash "$@"
fi
