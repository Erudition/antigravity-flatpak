#!/bin/sh
# Google Antigravity Flatpak Entry Point (Hardened Host-Integration)
# This script is installed as /app/bin/antigravity and manages the IDE environment.

# The ANTIGRAVITY_ACTIVE contract is used by the host ~/.bashrc to disable Starship.
# PAGER/MANPAGER=cat prevents "git log" and other interactive pagers from hanging.
export ANTIGRAVITY_ACTIVE=1
export PAGER=cat
export MANPAGER=cat

# Auto-Detection for Guix System
if [ -d "/gnu/store" ]; then
    HOST_UID=$(stat -c '%u' "$HOME")
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$HOST_UID/bus"
    
    # PATH Fix: Include Guix and Guix Home profiles.
    export PATH="$PATH:$HOME/.guix-home/profile/bin:$HOME/.config/guix/current/bin:$HOME/.guix-profile/bin"
    
    # Guile Load Path Fix
    export GUILE_LOAD_PATH="$HOME/.guix-home/profile/share/guile/site/3.0:$HOME/.config/guix/current/share/guile/site/3.0:$HOME/.guix-profile/share/guile/site/3.0:/run/current-system/profile/share/guile/site/3.0:$GUILE_LOAD_PATH"
    export GUILE_LOAD_COMPILED_PATH="$HOME/.guix-home/profile/lib/guile/3.0/site-ccache:$HOME/.config/guix/current/lib/guile/3.0/site-ccache:$HOME/.guix-profile/lib/guile/3.0/site-ccache:/run/current-system/profile/lib/guile/3.0/site-ccache:$GUILE_LOAD_COMPILED_PATH"
    
    # Graphics Fix
    export GBM_BACKENDS_PATH="/run/current-system/profile/lib/gbm"
    export __EGL_VENDOR_LIBRARY_DIRS="/run/current-system/profile/share/glvnd/egl_vendor.d"
fi

# Launch binary
if [ -x "/app/lib/antigravity/antigravity-ide" ]; then
    exec /app/lib/antigravity/antigravity-ide --no-sandbox --disable-setuid-sandbox "$@"
else
    exec /app/lib/antigravity/antigravity --no-sandbox --disable-setuid-sandbox "$@"
fi
